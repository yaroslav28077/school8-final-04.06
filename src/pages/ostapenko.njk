<script>
  // --- Web Audio API Synth Engine ---
  class CyberSynth {
    constructor() {
      this.ctx = null;
      this.enabled = false;
    }
    init() {
      if (!this.ctx) {
        this.ctx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }
    playClick() {
      if (!this.enabled) return;
      this.init();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      
      osc.type = 'sine';
      osc.frequency.setValueAtTime(900, this.ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(150, this.ctx.currentTime + 0.06);
      
      gain.gain.setValueAtTime(0.04, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.06);
      
      osc.start();
      osc.stop(this.ctx.currentTime + 0.06);
    }
    playSuccess() {
      if (!this.enabled) return;
      this.init();
      const now = this.ctx.currentTime;
      const playNote = (freq, start, duration) => {
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, start);
        gain.gain.setValueAtTime(0.06, start);
        gain.gain.exponentialRampToValueAtTime(0.001, start + duration);
        osc.start(start);
        osc.stop(start + duration);
      };
      playNote(523.25, now, 0.12);     // C5
      playNote(659.25, now + 0.08, 0.12); // E5
      playNote(783.99, now + 0.16, 0.12); // G5
      playNote(1046.50, now + 0.24, 0.25); // C6
    }
    playError() {
      if (!this.enabled) return;
      this.init();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(130, this.ctx.currentTime);
      osc.frequency.linearRampToValueAtTime(70, this.ctx.currentTime + 0.25);
      
      gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.25);
      
      osc.start();
      osc.stop(this.ctx.currentTime + 0.25);
    }
    playSweep() {
      if (!this.enabled) return;
      this.init();
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(100, this.ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(1400, this.ctx.currentTime + 2.5);
      
      gain.gain.setValueAtTime(0.03, this.ctx.currentTime);
      gain.gain.linearRampToValueAtTime(0.06, this.ctx.currentTime + 0.5);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 2.5);
      
      osc.start();
      osc.stop(this.ctx.currentTime + 2.5);
    }
  }

  const synth = new CyberSynth();

  // --- Sound Toggle Logic ---
  const soundToggle = document.getElementById('sound-toggle-switch');
  const soundLabel = soundToggle.querySelector('.switch-label');
  
  soundToggle.addEventListener('click', () => {
    synth.enabled = !synth.enabled;
    if (synth.enabled) {
      soundToggle.classList.add('active');
      soundLabel.textContent = 'Звук: On';
      synth.init();
      synth.playSuccess();
    } else {
      soundToggle.classList.remove('active');
      soundLabel.textContent = 'Звук: Off';
    }
  });

  // --- Mouse Glow Hover Effect for Bento Cards ---
  document.querySelectorAll('.bento-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // --- Background Grid Animation (Hacker Matrix canvas) ---
  const canvas = document.getElementById('hud-bg-canvas');
  const ctx = canvas.getContext('2d');
  
  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ<>[]$#@%&*+=?';
  const fontSize = 14;
  let columns = Math.floor(canvas.width / fontSize);
  let drops = Array(columns).fill(1);

  window.addEventListener('resize', () => {
    columns = Math.floor(canvas.width / fontSize);
    drops = Array(columns).fill(1);
  });

  function drawMatrix() {
    ctx.fillStyle = 'rgba(2, 4, 10, 0.05)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    ctx.fillStyle = 'rgba(0, 240, 255, 0.15)'; // Cyan matrix glow
    ctx.font = fontSize + 'px monospace';
    
    for (let i = 0; i < drops.length; i++) {
      const text = chars[Math.floor(Math.random() * chars.length)];
      ctx.fillText(text, i * fontSize, drops[i] * fontSize);
      
      if (drops[i] * fontSize > canvas.height && Math.random() > 0.985) {
        drops[i] = 0;
      }
      drops[i]++;
    }
  }

  let matrixInterval = setInterval(drawMatrix, 45);

  // --- Decryption Logic ---
  const initiateBtn = document.getElementById('initiate-decrypt-btn');
  const vaultLockedState = document.getElementById('vault-locked-state');
  const vaultProgressSection = document.getElementById('vault-progress-section');
  const vaultStatusIcon = document.getElementById('vault-status-icon');
  const progressBarFill = document.getElementById('decrypt-progress-fill');
  const progressPercentage = document.getElementById('decrypt-percentage');
  const scramblerText = document.getElementById('decrypt-scrambler-text');
  const photoRevealedWrap = document.getElementById('photo-revealed-wrap');
  const idPhoto = document.getElementById('unlocked-developer-photo');

  // Obfuscated string placeholder (will be replaced by build_page.js)
  const SCRAMBLED_DATA = "";

  function decryptData(scrambled) {
    // Reverse the string to get original Base64
    return scrambled.split('').reverse().join('');
  }

  let isDecrypting = false;
  let isDecrypted = false;

  initiateBtn.addEventListener('click', () => {
    if (isDecrypting || isDecrypted) return;
    
    synth.playClick();
    synth.playSweep();
    isDecrypting = true;

    // Transition elements
    vaultLockedState.style.display = 'none';
    vaultProgressSection.style.display = 'flex';
    vaultStatusIcon.style.color = '#c084fc';
    vaultStatusIcon.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i>';

    let progress = 0;
    const scrambledChars = "0123456789ABCDEF$#@%&*+=?";

    const interval = setInterval(() => {
      progress += 1;
      
      // Update UI elements
      progressBarFill.style.width = `${progress}%`;
      progressPercentage.textContent = `${progress}%`;

      // Scrambler effect
      let scrambled = "";
      for (let i = 0; i < 24; i++) {
        scrambled += scrambledChars[Math.floor(Math.random() * scrambledChars.length)];
      }
      scramblerText.textContent = `DECRYPTING: ${scrambled}`;

      if (progress >= 100) {
        clearInterval(interval);
        completeDecryption();
      }
    }, 25);
  });

  function completeDecryption() {
    isDecrypted = true;
    isDecrypting = false;

    const decryptedBase64 = decryptData(SCRAMBLED_DATA);
    idPhoto.src = `data:image/jpeg;base64,${decryptedBase64}`;

    // Hide progress elements and show photo
    vaultProgressSection.style.display = 'none';
    vaultStatusIcon.style.color = '#00f0ff';
    vaultStatusIcon.style.textShadow = '0 0 15px rgba(0, 240, 255, 0.6)';
    vaultStatusIcon.innerHTML = '<i class="fas fa-lock-open"></i>';
    photoRevealedWrap.style.display = 'flex';

    writeLog('DECRYPTION COMPLETE. PROFILE ATTACHED.', 'success');
  }

  // --- Mentor Thanks Tributes Database ---
  const tributes = {
    yurchenko: {
      quote: "Дякую за підтримку моїх технічних ініціатив, довіру в реалізації нового веб-порталу гімназії та відкритість до сучасних змін у закладі.",
      author: "Аліна Юрченко — Директорка"
    },
    hrytsai: {
      quote: "Дякую за все: за вашу безмежну довіру та свободу дій, за можливість експериментувати та пробувати нове. Навіть коли траплялися невдачі, ви ніколи не засмучувались, а продовжували вірити в мене та підтримувати. Дякую за те, що в будь-який момент могли забрати мене з уроків до комп'ютерного класу для важливих справ, і окреме спасибі за крутий досвід у сфері 3D-друку. Щиро бажаю, щоб наша гімназія і надалі розвивалася, кабінети осучаснювалися, а учні отримали нові потужні комп'ютери!",
      author: "Тетяна Грицай — Вчителька"
    },
    lytvykh: {
      quote: "Дякую за неймовірну організацію свят і за те, що колись вперше довірили мені шкільну звукову апаратуру. Дякую за те, що залучали майже до кожної події, вірили в мене та часто відпускали з уроків. І хоча останнім часом про заходи я міг дізнатися в останній момент — за день чи навіть перед самим початком — я завжди був готовий на всі 100% відпрацювати за пультом. Також величезне спасибі за найцікавіші уроки зарубіжної літератури та вашу постійну віру в мої сили!",
      author: "Тетяна Литвих — Вчителька"
    },
    symonenko: {
      quote: "Дякую за організацію свят та вашу постійну допомогу і підтримку в роботі з музичною апаратурою. Дякую за довіру, за те, що за потреби забирали з уроків, та за наші поїздки на різноманітні заходи на вашому рідненькому білому Опелі. Ці спогади та ваш теплий підхід назавжди залишаться зі мною!",
      author: "Наталія Симоненко — Вчителька"
    }
  };

  const mentorCards = document.querySelectorAll('.mentor-card');
  const tributePlaceholder = document.getElementById('tribute-box-placeholder');
  const tributeContent = document.getElementById('tribute-box-content');
  const tributeText = document.getElementById('tribute-quote-text');
  const tributeAuthor = document.getElementById('tribute-quote-author');

  mentorCards.forEach(card => {
    card.addEventListener('click', () => {
      synth.playClick();
      
      const mentorKey = card.getAttribute('data-mentor');
      const mentorData = tributes[mentorKey];

      // Reset active states
      mentorCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');

      if (mentorData) {
        tributePlaceholder.style.display = 'none';
        tributeContent.style.display = 'flex';
        tributeText.textContent = mentorData.quote;
        tributeAuthor.textContent = mentorData.author;
        
        writeLog(`TRIBUTE ACCESSED: ${mentorKey.toUpperCase()}`, 'system');
      }
    });
  });

  // --- Terminal Command Console Logic ---
  const consoleLogs = document.getElementById('console-logs-screen');
  const consoleInput = document.getElementById('console-input-field');

  function writeLog(text, type = '') {
    const line = document.createElement('div');
    line.className = `console-log-line ${type}`;
    line.textContent = `[${new Date().toLocaleTimeString()}] ${text}`;
    consoleLogs.appendChild(line);
    consoleLogs.scrollTop = consoleLogs.scrollHeight;
  }

  consoleInput.addEventListener('keydown', e => {
    if (e.key === 'Enter') {
      const command = consoleInput.value.trim();
      consoleInput.value = '';
      
      if (command) {
        executeCommand(command);
      }
    }
  });

  function executeCommand(cmd) {
    synth.playClick();
    writeLog(`guest@ukg-dev:~$ ${cmd}`, 'user');
    
    const cleanCmd = cmd.toLowerCase().trim();

    switch(cleanCmd) {
      case 'help':
        writeLog('Доступні команди:');
        writeLog('  about   - Профайл розробника.');
        writeLog('  thanks  - Перелік подяк.');
        writeLog('  decrypt - Дешифрувати архів.');
        writeLog('  audio   - Увімкнути/вимкнути звук.');
        writeLog('  clear   - Очистити термінал.');
        writeLog('  exit    - Повернутися на головну.');
        break;
      
      case 'about':
        writeLog('Ярослав Остапенко — Lead Developer & Architect.');
        writeLog('Контакт: Telegram @prosto0728.');
        writeLog('Проект: school8-final (Українська класична гімназія).');
        break;

      case 'thanks':
        writeLog('Подяки викладачам: Аліна Юрченко, Тетяна Грицай, Тетяна Литвих, Наталія Симоненко.');
        writeLog('Клацніть відповідні картки на екрані, щоб дізнатися більше.');
        break;

      case 'decrypt':
        if (isDecrypted) {
          writeLog('Архів уже розблоковано.', 'success');
        } else if (isDecrypting) {
          writeLog('Процес дешифрування вже триває...', 'system');
        } else {
          writeLog('Запуск дешифрування...');
          initiateBtn.click();
        }
        break;

      case 'audio':
        soundToggle.click();
        writeLog(`Звуковий супровід встановлено: ${synth.enabled ? 'ON' : 'OFF'}`, 'system');
        break;

      case 'clear':
        consoleLogs.innerHTML = '';
        break;

      case 'exit':
        writeLog('Вихід з термінала...', 'error');
        setTimeout(() => {
          window.location.href = '/';
        }, 800);
        break;

      default:
        synth.playError();
        writeLog(`Помилка: Команда "${cmd}" не знайдена. Спробуйте "help".`, 'error');
    }
  }

  // --- Exit Button Logic ---
  const exitBtn = document.getElementById('console-exit-btn');
  exitBtn.addEventListener('click', () => {
    synth.playClick();
    synth.playError();
    writeLog('TERMINATING SESSION...', 'error');
    setTimeout(() => {
      window.location.href = '/';
    }, 500);
  });
</script>
