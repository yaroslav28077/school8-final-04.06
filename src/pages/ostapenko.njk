  }

  @media (max-width: 640px) {
    .mentors-grid {
      grid-template-columns: 1fr;
    }
    
    .stats-grid {
      grid-template-columns: 1fr;
    }
    
    .hud-header {
      padding: 0 16px;
    }

    .exit-btn {
      padding: 6px 10px;
      font-size: 0.75rem;
    }
