---
title: "Система керування розробника"
layout: "layout.njk"
pagination:
  data: permalinks
  size: 1
  alias: path
permalinks:
  - /ostapenko/
  - /yaroslav/
  - /yarik/
permalink: "{{ path }}"
eleventyExcludeFromCollections: true
editable: false
description: "Голографічний кібер-дашборд розробника сайту Ярослава Остапенка."
page_styles: |
  /* --- Reset & Immersive Overlay --- */
  .cyber-hud-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    background: radial-gradient(circle at center, #060b19 0%, #02040a 100%);
    color: #e2e8f0;
    font-family: 'Open Sans', sans-serif;
    overflow-y: auto;
    overflow-x: hidden;
  }

  .cyber-hud-container * {
    box-sizing: border-box;
  }

  /* --- Cyber Fonts --- */
  .mono-font {
    font-family: 'Fira Code', 'Courier New', monospace;
  }

  /* --- Background Grid Canvas --- */
  .hud-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    opacity: 0.15;
  }

  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(0, 240, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 240, 255, 0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 2;
    pointer-events: none;
  }

  /* --- Scanline Animation Overlay --- */
  .scanlines-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.2) 50%);
    background-size: 100% 4px;
    z-index: 99999;
    pointer-events: none;
    opacity: 0.75;
  }

  .scanline-sweep {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, transparent 0%, rgba(0, 240, 255, 0.05) 10%, rgba(0, 240, 255, 0.08) 50%, rgba(0, 240, 255, 0.05) 90%, transparent 100%);
    z-index: 99999;
    pointer-events: none;
    animation: sweep 8s linear infinite;
  }

  @keyframes sweep {
    0% { transform: translateY(-100vh); }
    100% { transform: translateY(100vh); }
  }

  /* --- Header Bar --- */
  .hud-header {
    height: 64px;
    background: rgba(4, 8, 20, 0.85);
    border-bottom: 1px solid rgba(0, 240, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(8px);
  }

  .hud-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hud-badge {
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid #00f0ff;
    color: #00f0ff;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
    animation: pulseGlow 2s infinite alternate;
  }

  @keyframes pulseGlow {
    from { box-shadow: 0 0 5px rgba(0, 240, 255, 0.1); border-color: rgba(0, 240, 255, 0.5); }
    to { box-shadow: 0 0 15px rgba(0, 240, 255, 0.4); border-color: #00f0ff; }
  }

  .hud-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 2px;
    background: linear-gradient(90deg, #00f0ff, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-transform: uppercase;
  }

  .hud-controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* --- Toggle Switch --- */
  .switch-container {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .switch-label {
    font-size: 0.75rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .switch-btn {
    position: relative;
    width: 48px;
    height: 24px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 12px;
    transition: all 0.3s;
  }

  .switch-btn::before {
    content: '';
    position: absolute;
    top: 3px;
    left: 4px;
    width: 16px;
    height: 16px;
    background: #94a3b8;
    border-radius: 50%;
    transition: all 0.3s;
  }

  .switch-container.active .switch-btn {
    background: rgba(0, 240, 255, 0.1);
    border-color: #00f0ff;
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
  }

  .switch-container.active .switch-btn::before {
    left: 26px;
    background: #00f0ff;
    box-shadow: 0 0 8px #00f0ff;
  }

  .switch-container.active .switch-label {
    color: #00f0ff;
  }

  .exit-btn {
    background: transparent;
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
    padding: 6px 16px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
  }

  .exit-btn:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: #ef4444;
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.2);
  }

  /* --- Main HUD Layout --- */
  .hud-content {
    max-width: 1300px;
    margin: 0 auto;
    padding: 24px;
    position: relative;
    z-index: 5;
  }

  /* --- Intro Banner --- */
  .intro-banner {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.7) 0%, rgba(30, 41, 59, 0.3) 100%);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .intro-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: 1px;
  }

  .intro-desc {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* --- Symmetrical Two-Column Dashboard Layout --- */
  .hud-layout-wrapper {
    display: grid;
    grid-template-columns: 4.5fr 7.5fr;
    gap: 24px;
    align-items: start;
  }

  .hud-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .bento-card {
    background: rgba(10, 18, 36, 0.55);
    border: 1px solid rgba(0, 240, 255, 0.1);
    border-radius: 16px;
    backdrop-filter: blur(12px);
    padding: 24px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  .bento-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 240, 255, 0.08) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  .bento-card:hover {
    border-color: rgba(0, 240, 255, 0.3);
    box-shadow: 0 15px 40px rgba(0, 240, 255, 0.08), 0 0 30px rgba(0, 240, 255, 0.02);
    transform: translateY(-4px);
  }

  .bento-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 12px;
  }

  .bento-card-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #f1f5f9;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .bento-card-title i {
    color: #00f0ff;
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
  }

  /* --- Profile Details Styling --- */
  .profile-block {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 24px;
  }

  .profile-avatar-placeholder {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.15), rgba(192, 132, 252, 0.15));
    border: 2px solid rgba(0, 240, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-6px); }
  }

  .profile-avatar-placeholder i {
    font-size: 1.8rem;
    color: #00f0ff;
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
  }

  .profile-info {
    display: flex;
    flex-direction: column;
  }

  .profile-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 2px;
  }

  .profile-role {
    font-size: 0.8rem;
    color: #c084fc;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: all 0.3s;
  }

  .stat-card:hover {
    border-color: rgba(0, 240, 255, 0.2);
    background: rgba(15, 23, 42, 0.8);
  }

  .stat-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }

  .stat-value-wrap {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .stat-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: #00f0ff;
    font-family: 'Fira Code', monospace;
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.1);
  }

  .stat-unit {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .tg-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    background: linear-gradient(135deg, rgba(0, 136, 204, 0.2) 0%, rgba(0, 240, 255, 0.1) 100%);
    border: 1px solid rgba(0, 240, 255, 0.3);
    color: #00f0ff;
    padding: 12px;
    border-radius: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
  }

  .tg-action-btn:hover {
    background: linear-gradient(135deg, rgba(0, 136, 204, 0.4) 0%, rgba(0, 240, 255, 0.25) 100%);
    border-color: #00f0ff;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.25);
    transform: translateY(-1px);
  }

  /* --- Decryption Chamber Styling --- */
  .decrypt-chamber {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 240px;
  }

  .vault-screen {
    background: rgba(3, 7, 18, 0.8);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 12px;
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .vault-status-icon {
    font-size: 3.5rem;
    color: #f43f5e;
    text-shadow: 0 0 20px rgba(244, 63, 94, 0.4);
    margin-bottom: 16px;
    animation: blinkLock 2s infinite alternate;
  }

  @keyframes blinkLock {
    from { opacity: 0.7; transform: scale(1); }
    to { opacity: 1; transform: scale(1.05); }
  }

  .vault-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .vault-subtitle {
    font-size: 0.85rem;
    color: #64748b;
    text-align: center;
    max-width: 380px;
    margin-bottom: 24px;
  }

  .vault-btn {
    background: linear-gradient(135deg, #00f0ff 0%, #c084fc 100%);
    border: none;
    color: #0f172a;
    padding: 14px 28px;
    border-radius: 10px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 0 0 25px rgba(0, 240, 255, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vault-btn:hover {
    box-shadow: 0 0 35px rgba(192, 132, 252, 0.5);
    transform: scale(1.03);
  }

  .vault-btn:active {
    transform: scale(0.98);
  }

  /* Progress Section */
  .vault-progress-section {
    width: 100%;
    max-width: 450px;
    display: none;
    flex-direction: column;
    align-items: center;
  }

  .vault-progress-label-wrap {
    display: flex;
    width: 100%;
    justify-content: space-between;
    font-size: 0.75rem;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .progress-bar-bg {
    width: 100%;
    height: 10px;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #00f0ff, #c084fc);
    border-radius: 5px;
    box-shadow: 0 0 10px #00f0ff;
    transition: width 0.1s linear;
  }

  .console-scrambler {
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: #c084fc;
    min-height: 20px;
    text-align: center;
    width: 100%;
    word-break: break-all;
  }

  /* Photo Revealed Section */
  .photo-revealed-wrap {
    display: none;
    flex-direction: column;
    align-items: center;
    animation: revealZoom 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
  }

  @keyframes revealZoom {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
  }

  .id-card-frame {
    border: 2px solid #00f0ff;
    box-shadow: 0 0 35px rgba(0, 240, 255, 0.3);
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    max-width: 200px;
    position: relative;
  }

  .id-photo {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(95%) contrast(105%) saturate(90%);
    transition: filter 0.3s;
  }

  .id-card-frame:hover .id-photo {
    filter: brightness(110%) contrast(110%) saturate(100%);
  }

  .id-card-scanline {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, transparent 95%, rgba(0, 240, 255, 0.4) 95%);
    background-size: 100% 20px;
    pointer-events: none;
    animation: sweepSlow 4s linear infinite;
  }

  @keyframes sweepSlow {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  .id-details {
    margin-top: 14px;
    text-align: center;
  }

  .id-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #f8fafc;
  }

  .id-subtitle {
    font-size: 0.7rem;
    color: #00f0ff;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 2px;
    font-weight: 700;
  }

  /* --- Mentor/Teacher Section Styling --- */
  .mentors-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mentors-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .mentor-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .mentor-card:hover {
    border-color: rgba(192, 132, 252, 0.4);
    box-shadow: 0 0 15px rgba(192, 132, 252, 0.15);
    transform: translateY(-2px);
    background: rgba(15, 23, 42, 0.85);
  }

  .mentor-card.active {
    border-color: #00f0ff;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);
    background: rgba(0, 240, 255, 0.05);
  }

  .mentor-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: #94a3b8;
    transition: all 0.3s;
  }

  .mentor-card:hover .mentor-avatar {
    color: #c084fc;
    border-color: #c084fc;
    box-shadow: 0 0 10px rgba(192, 132, 252, 0.2);
  }

  .mentor-card.active .mentor-avatar {
    color: #00f0ff;
    border-color: #00f0ff;
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
  }

  .mentor-name {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .mentor-role {
    font-size: 0.7rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .mentor-card.active .mentor-role {
    color: #94a3b8;
  }

  /* Tribute Display Box */
  .tribute-box {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 12px;
    padding: 20px;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    backdrop-filter: blur(4px);
  }

  .tribute-placeholder {
    color: #64748b;
    font-size: 0.9rem;
    text-align: center;
    font-style: italic;
  }

  .tribute-active {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    animation: fadeSlide 0.4s ease-out;
  }

  @keyframes fadeSlide {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tribute-quote {
    color: #e2e8f0;
    font-size: 0.95rem;
    line-height: 1.6;
    position: relative;
    padding-left: 20px;
    border-left: 2px solid #00f0ff;
  }

  .tribute-author {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    color: #00f0ff;
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
  }

  /* --- Mini Command Console Styling --- */
  .console-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 250px;
  }

  .console-screen {
    flex: 1;
    background: rgba(3, 7, 18, 0.9);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: 12px 12px 0 0;
    padding: 16px;
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    color: #00f0ff;
    overflow-y: auto;
    height: 160px;
    scroll-behavior: smooth;
  }

  .console-screen::-webkit-scrollbar {
    width: 4px;
  }
  .console-screen::-webkit-scrollbar-thumb {
    background: rgba(0, 240, 255, 0.2);
    border-radius: 2px;
  }

  .console-log-line {
    margin-bottom: 6px;
    line-height: 1.4;
    white-space: pre-wrap;
  }

  .console-log-line.system { color: #c084fc; }
  .console-log-line.error { color: #f43f5e; }
  .console-log-line.success { color: #34d399; }
  .console-log-line.user { color: #f8fafc; }

  .console-input-bar {
    display: flex;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-top: none;
    border-radius: 0 0 12px 12px;
    padding: 10px 14px;
    align-items: center;
    gap: 8px;
  }

  .console-symbol {
    color: #00f0ff;
    font-weight: 700;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
  }

  .console-input {
    flex: 1;
